class ChunkedFileReader {
  + fileOutputStream: FileInputStream 
  + chunkSize: int 
  - endOfFile: boolean 
  --
  + ChunkedFileReader(filePath: String, chunkSize: int)
  + readNextChunk(): byte[]
  + close(): void
}

class Logger {
  + ANSI_RED: String {static} {readOnly}
  + ANSI_WHITE: String {static} {readOnly}
  + ANSI_YELLOW: String {static} {readOnly}
  + ANSI_GREEN: String {static} {readOnly}
  + ANSI_CYAN: String {static} {readOnly}
  + ANSI_RESET: String {static} {readOnly}
  - logger: Logger {static}
  - logFile: File 
  --
  + Logger():
  + getInstance(): Logger {static}
  + info(message: String): void {static}
  + success(message: String): void {static}
  + warn(message: String): void {static}
  + error(message: String): void {static}
  + exception(e: Exception): void {static}
  + log(loggingType: LoggingType, message: String): void {static}
  + logToFile(message: String): void {static}
}

enum LoggingType {
  - value: String
  --
  - LoggingType(value: String)
}

enum ServerCommand {
  + argsAmount: int 
  --
  - ServerCommand(argsAmount: int)
  + getArgsAmount(): int
  + hasCorrectArgsAmount(currentArgsAmount: int): boolean
}

enum ServerResponse {
}

interface Command {
  + hasCorrectArgsAmount(length: int): boolean
}

enum ClientCommand {
  + argsAmount: int 
  --
  - ClientCommand(argsAmount: int)
  + hasCorrectArgsAmount(currentArgsAmount: int): boolean
}

class NetworkFile {
