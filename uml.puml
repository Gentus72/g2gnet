  + connectToCC(ccAddress: String, networkUUID: String): void
  + startServer(args: String[]): void
  + getCCServer(): CCServer
  + setCCServer(ccServer: CCServer): void
  + getServerFile(): ServerFile
  + setServerFile(serverFile: ServerFile): void
  + getRessourceDirectory(): String {static}
}

class ClientHelper {
  + wasCommandSuccessfull: boolean  {static}
  --
  + handleServerInteraction(client: Client, args: String[]): void {static}
  + handleClientInteraction(client: Client, args: String[]): void {static}
  + handleServerResponseREDIRECT(client: Client, args: String[]): void {static}
  + handleServerResponseINFO(client: Client, args: String[]): void {static}
  + handleServerResponseDOWNLOAD(client: Client, args: String[]): void {static}
  + handleServerResponseAUTH(client: Client, args: String[]): void {static}
  + handleServerResponseSUCCESS(client: Client, args: String[]): void {static}
  + handleServerResponseERROR(clinet: Client, args: String[]): void {static}
  + handleClientCommandCONNECT(client: Client, args: String[]): void {static}
  + handleClientCommandINFO(client: Client, args: String[]): void {static}
  + handleClientCommandAUTOGET(client: Client, args: String[]): void {static}
  + handleClientCommandFULLUPLOAD(client: Client, args: String[]): void {static}
  + handleClientCommandAUTOUPLOAD(client: Client, args: String[]): void {static}
  + handleClientCommandEXIT(client: Client, args: String[]): void {static}
