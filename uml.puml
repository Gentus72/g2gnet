@startuml
!theme plain
skinparam classAttributeIconSize 0

class Client {
  + RESSOURCE_DIRECTORY: String {static} {readOnly}
  + currentHost: String 
  + hostPort: int 
  + socket: Socket 
  + outputStream: DataOutputStream 
  + inputStream: DataInputStream 
  + userInputScanner: Scanner 
  + clientFile: ClientFile 
  + isConnected: boolean
  + currentClientInput: String[] 
  + registeredClientCommands: HashMap<ClientCommand, BiConsumer<Client, String[]>>
  + registeredServerResponses: HashMap<ServerResponse, BiConsumer<Client, String[]>>
  --
  + main(args: String[]): void {static}
  + Client()
  + startClient(): void
  + registerCommands(): void
}

class HostServer {
  + clients: ArrayList<ClientDTO> 
  + ccServer: CCServer 
  + serverFile: ServerFile 
  --
  + main(args: String[]): void {static}
