  - data: byte[] 
  --
  + RessourceBlock(uuid: String)
  + writeToFile(): void
  + setData(data: byte[]): void
  + getData(): byte[]
  + setParentDirectory(parentDirectory: String): void
}

class Ressource {
  + BLOCK_SIZE: long {static} {readOnly}
  - sourceFile: File 
  - parentDirectory: File 
  - ressourceFile: RessourceFile 
  - blockLocations: HashMap<RessourceBlockDTO, String> 
  --
  + Ressource(sourceFile: File, title: String)
  + disassemble(parentDirectory: String, sourceFile: File, title: String, clientPublicKey: String): Ressource {static}
  + reassemble(parentDirectory: String, uuid: String, outputFile: File): Ressource {static}
  + doesLocalRessourceExist(parentDirectory: String, sourceFile: File): boolean {static}
  + getSourceFile(): File
  + getBlockAmount(): int
  + getParentDirectory(): File
  + setParentDirectory(parentDirectory: File): void
  + getRessourceFile(): RessourceFile
  + setRessourceFile(ressourceFile: RessourceFile): void
  + setBlockLocations(blockLocations: String>): void
  + getBlockLocations(): HashMap<RessourceBlockDTO, String>
}

class CCClientHandler {
  + CCClientHandler(server: CCServer, serverSocket: Socket)
  + handleCommandINFO(args: String[]): void
  + handleCommandAUTH(args: String[]): void
  + handleCommandREGISTER(args: String[]): void
  + sendAllow(address: String, clientPublicKey: String, ressourceUUID: String, blockUUID: String): boolean
}

class CCServer {
  - networkUUID: String 
  - servers: ArrayList<ServerDTO> 
  - ressources: ArrayList<RessourceDTO> 
  - networkFile: NetworkFile 
  - networkLabel: String 
  --
  + main(args: String[]): void {static}
  + CCServer()
  + CCServer(address: String)
  + startServer(args: String[]): void
  + getNetworkUUID(): String
  + setNetworkUUID(networkUUID: String): void
  + getServers(): ArrayList<ServerDTO>
  + setServers(servers: ArrayList<ServerDTO>): void
  + addServer(server: ServerDTO): void
  + getRessources(): ArrayList<RessourceDTO>
  + setRessources(ressources: ArrayList<RessourceDTO>): void
  + addRessource(ressource: RessourceDTO): void
  + getNetworkFile(): NetworkFile
  + getRessourceDirectory(): String {static}
  + getNetworkLabel(): String
  + setNetworkLabel(networkLabel: String): void
}

class HostClientHandler {
  + HostClientHandler(server: HostServer, serverSocket: Socket)
  + handleCommandALLOW(args: String[]): void
  + handleCommandAUTH(args: String[]): void
}

class G2GUtil {
  + getRandomUUID(): String {static}
  + getLocalIPv4Address(): String {static}
  + sendFileRemote(fileName: String, outputStream: DataOutputStream): void {static}
  + sendFileRemote(file: File, outputStream: DataOutputStream): void {static}
